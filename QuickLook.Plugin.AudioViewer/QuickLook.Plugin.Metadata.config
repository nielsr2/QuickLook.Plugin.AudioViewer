<Metadata>
  <Namespace>QuickLook.Plugin.AudioViewer</Namespace>
  <Version>1.6.0</Version>
  <Description>Audio previewer: waveform, playback, embedded tags and cover art, and a configurable linear/log/mel spectrogram with axes, a colorbar legend, and a hover readout. Light/dark theme aware.</Description>
</Metadata>
