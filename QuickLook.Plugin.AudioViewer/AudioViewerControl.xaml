<UserControl x:Class="QuickLook.Plugin.AudioViewer.AudioViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QuickLook.Plugin.AudioViewer.Controls"
             Background="#FF1E1E1E">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Transport bar -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="PlayPauseButton" Grid.Column="0" Width="40" Height="28"
              Content="&#9654;" Click="PlayPauseButton_Click"/>
      <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
              Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
              Thumb.DragStarted="SeekSlider_DragStarted"
              Thumb.DragCompleted="SeekSlider_DragCompleted"/>
      <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center"
                 Foreground="#FFDDDDDD" Margin="4,0" Text="00:00 / 00:00"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                   Foreground="#FFDDDDDD" VerticalAlignment="Center" Margin="0,0,5,0"
                   ToolTip="Volume"/>
        <Slider x:Name="VolumeSlider" Width="80" VerticalAlignment="Center"
                Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged"/>
      </StackPanel>
      <CheckBox x:Name="AutoPlayCheck" Grid.Column="4" VerticalAlignment="Center"
                Foreground="#FFDDDDDD" Content="Auto-play"
                Checked="AutoPlayCheck_Changed" Unchecked="AutoPlayCheck_Changed"/>

      <ToggleButton x:Name="SettingsButton" Grid.Column="5" Width="30" Height="28"
                    Margin="6,0,0,0" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    FontSize="14" Padding="0" ToolTip="Spectrogram settings"/>
      <Popup PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True"
             IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
        <Border Background="#FF2A2A2A" BorderBrush="#FF565656" BorderThickness="1"
                Padding="12" Margin="0,4,10,10">
          <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
          </Border.Effect>
          <StackPanel Width="180">
            <CheckBox x:Name="FileInfoCheck" Content="Show file info" Foreground="#FFDDDDDD"
                      Margin="0,0,0,10" Checked="FileInfoCheck_Changed" Unchecked="FileInfoCheck_Changed"/>

            <TextBlock Text="Layout" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <ComboBox x:Name="LayoutCombo" Margin="0,0,0,8" SelectionChanged="LayoutCombo_Changed">
              <ComboBoxItem Content="Stacked"/>
              <ComboBoxItem Content="Single view"/>
            </ComboBox>

            <TextBlock Text="Frequency scale" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <ComboBox x:Name="FreqCombo" Margin="0,0,0,8" SelectionChanged="FreqCombo_Changed">
              <ComboBoxItem Content="Linear"/>
              <ComboBoxItem Content="Log"/>
              <ComboBoxItem Content="Mel"/>
            </ComboBox>

            <TextBlock Text="Amplitude" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <ComboBox x:Name="AmpCombo" Margin="0,0,0,8" SelectionChanged="AmpCombo_Changed">
              <ComboBoxItem Content="Decibel (dB)"/>
              <ComboBoxItem Content="Linear"/>
            </ComboBox>

            <TextBlock Text="Colormap" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <ComboBox x:Name="ColorCombo" Margin="0,0,0,8" SelectionChanged="ColorCombo_Changed">
              <ComboBoxItem Content="Magma"/>
              <ComboBoxItem Content="Viridis"/>
              <ComboBoxItem Content="Grayscale"/>
            </ComboBox>

            <TextBlock Text="FFT size" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <ComboBox x:Name="FftCombo" Margin="0,0,0,8" SelectionChanged="FftCombo_Changed">
              <ComboBoxItem Content="512"/>
              <ComboBoxItem Content="1024"/>
              <ComboBoxItem Content="2048"/>
              <ComboBoxItem Content="4096"/>
            </ComboBox>

            <TextBlock Text="Max frequency" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <ComboBox x:Name="MaxFreqCombo" Margin="0,0,0,8" SelectionChanged="MaxFreqCombo_Changed">
              <ComboBoxItem Content="Full"/>
              <ComboBoxItem Content="20 kHz"/>
              <ComboBoxItem Content="10 kHz"/>
              <ComboBoxItem Content="5 kHz"/>
            </ComboBox>

            <TextBlock Text="Contrast (dB floor)" Foreground="#FFBBBBBB" Margin="0,0,0,2"/>
            <Slider x:Name="ContrastSlider" Minimum="-120" Maximum="-40"
                    SmallChange="1" LargeChange="10" ValueChanged="ContrastSlider_Changed"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- View pane. A horizontally-scrollable timeline holds the waveform (top,
         1*) and spectrogram (bottom, 4*) at the same width, so they stay aligned
         in time; long files render in full and scroll instead of truncating.
         Single-view layout collapses the wave row to 0 and toggles one view.
         Timeline width is set in code; MinWidth keeps short files filling the pane. -->
    <Grid Grid.Row="1" x:Name="ViewPaneGrid">
      <ScrollViewer x:Name="ViewScroll" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="ViewScroll_PreviewMouseWheel">
        <Grid x:Name="Timeline"
              Height="{Binding ViewportHeight, ElementName=ViewScroll}"
              MinWidth="{Binding ViewportWidth, ElementName=ViewScroll}">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="WaveRow" Height="1*"/>
            <RowDefinition x:Name="SpecRow" Height="4*"/>
          </Grid.RowDefinitions>

          <ScrollViewer x:Name="WaveScroll" Grid.Row="0"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- MinHeight keeps mono/stereo waveforms stretched to fill the pane like
                 before multichannel support; many-channel files exceed the viewport at
                 LaneHeight-per-channel and this MinHeight has no effect, so they scroll. -->
            <ctl:WaveformView x:Name="Waveform" MinHeight="{Binding ViewportHeight, ElementName=WaveScroll}"/>
          </ScrollViewer>
          <Image x:Name="SpectrogramImage" Grid.Row="1" Stretch="Fill" Visibility="Collapsed"/>
          <Rectangle x:Name="SpectrogramPlayhead" Grid.Row="0" Grid.RowSpan="2" Width="1.5"
                     Fill="#FFFF5252" HorizontalAlignment="Left" Visibility="Collapsed"/>
        </Grid>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Foreground="#FFBBBBBB"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="Loading…"/>

      <!-- File-info overlay (toggled from settings). Bottom-right by default;
           draggable anywhere in the pane; a ✕ closes it. Wheel events are
           forwarded so the timeline still scrolls when the pointer is over it. -->
      <Border x:Name="FileInfoPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,10,10" Padding="9,6,9,7" CornerRadius="3" Background="#CC000000"
              BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed"
              Cursor="SizeAll"
              MouseLeftButtonDown="FileInfoPanel_MouseLeftButtonDown"
              MouseMove="FileInfoPanel_MouseMove"
              MouseLeftButtonUp="FileInfoPanel_MouseLeftButtonUp"
              PreviewMouseWheel="ViewScroll_PreviewMouseWheel">
        <Border.RenderTransform>
          <TranslateTransform x:Name="FileInfoTranslate"/>
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="FileInfoClose" Grid.Row="0" Text="&#xE8BB;"
                     FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right"
                     Foreground="#FFCCCCCC" Cursor="Hand" Margin="0,0,0,3" ToolTip="Close"
                     MouseLeftButtonDown="FileInfoClose_Click"/>
          <TextBlock x:Name="FileInfoText" Grid.Row="1" Foreground="#FFEDEDED"
                     FontFamily="Consolas, Courier New" FontSize="11"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Channel selector (multichannel files only) + toggle button -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <ComboBox x:Name="ChannelCombo" Width="140" Margin="0,0,8,0" Visibility="Collapsed"
                VerticalAlignment="Center" SelectionChanged="ChannelCombo_Changed"/>
      <Button x:Name="SpectrogramButton" Padding="10,4" Content="Spectrogram ▸"
              Click="SpectrogramButton_Click"/>
    </StackPanel>
  </Grid>
</UserControl>
