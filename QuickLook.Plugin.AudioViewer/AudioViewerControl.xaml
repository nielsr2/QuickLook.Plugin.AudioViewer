<UserControl x:Class="QuickLook.Plugin.AudioViewer.AudioViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:QuickLook.Plugin.AudioViewer.Controls"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown"
             Background="{DynamicResource AppBackground}">
  <!-- Brush keys are overwritten per light/dark theme in the constructor
       (ThemePalette.Apply). These defaults are the dark palette so the control
       still resolves them if applied late. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#FFBBBBBB"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="PopupBorder" Color="#FF565656"/>
    <SolidColorBrush x:Key="OverlayBackground" Color="#CC000000"/>
    <SolidColorBrush x:Key="OverlayBorder" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="OverlayText" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="OverlayClose" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="Playhead" Color="#FFFF5252"/>
  </UserControl.Resources>
  <!-- IsSharedSizeScope lets the seek bar and the horizontal scrollbar share the
       spectrogram's left/right gutter widths (frequency ruler and colorbar), so they
       line up horizontally with the waveform and spectrogram. -->
  <Grid Margin="12" Grid.IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 0: transport controls -->
      <RowDefinition Height="Auto"/>   <!-- 1: playback timeline -->
      <RowDefinition Height="*"/>       <!-- 2: waveform + spectrogram -->
      <RowDefinition Height="Auto"/>   <!-- 3: horizontal scrollbar (below the plot) -->
      <RowDefinition Height="Auto"/>   <!-- 4: single-view toggle -->
    </Grid.RowDefinitions>

    <!-- Transport controls (the timeline is on its own row below) -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>   <!-- play -->
        <ColumnDefinition Width="Auto"/>   <!-- time -->
        <ColumnDefinition Width="*"/>       <!-- spacer -->
        <ColumnDefinition Width="Auto"/>   <!-- mute + volume -->
        <ColumnDefinition Width="Auto"/>   <!-- auto-play -->
        <ColumnDefinition Width="Auto"/>   <!-- settings -->
      </Grid.ColumnDefinitions>

      <Button x:Name="PlayPauseButton" Grid.Column="0" Width="40" Height="28"
              Content="&#9654;" Click="PlayPauseButton_Click"/>
      <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center"
                 Foreground="{DynamicResource PrimaryText}" Margin="10,0" Text="00:00 / 00:00"/>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
        <Button x:Name="MuteButton" Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="0,0,5,0"
                Cursor="Hand" ToolTip="Mute / unmute (M)" Click="MuteButton_Click">
          <!-- Chrome-free: render the glyph only, so it reads as an icon not a button. -->
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" Padding="2,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Slider x:Name="VolumeSlider" Width="80" VerticalAlignment="Center"
                Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged"/>
      </StackPanel>
      <CheckBox x:Name="AutoPlayCheck" Grid.Column="4" VerticalAlignment="Center"
                Foreground="{DynamicResource PrimaryText}" Content="Auto-play"
                Checked="AutoPlayCheck_Changed" Unchecked="AutoPlayCheck_Changed"/>

      <ToggleButton x:Name="SettingsButton" Grid.Column="5" Width="30" Height="28"
                    Margin="6,0,0,0" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    FontSize="14" Padding="0" ToolTip="Spectrogram settings"/>
      <Popup PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True"
             IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
        <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
                BorderThickness="1" Padding="12" Margin="0,4,10,10">
          <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
          </Border.Effect>
          <StackPanel Width="180">
            <CheckBox x:Name="FileInfoCheck" Content="Show file info" Foreground="{DynamicResource PrimaryText}"
                      Margin="0,0,0,10" Checked="FileInfoCheck_Changed" Unchecked="FileInfoCheck_Changed"/>

            <TextBlock Text="File info style" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="FileInfoStyleCombo" Margin="0,0,0,8" SelectionChanged="FileInfoStyleCombo_Changed">
              <ComboBoxItem Content="Icon (hover)"/>
              <ComboBoxItem Content="Draggable box"/>
            </ComboBox>

            <TextBlock Text="Layout" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="LayoutCombo" Margin="0,0,0,8" SelectionChanged="LayoutCombo_Changed">
              <ComboBoxItem Content="Stacked"/>
              <ComboBoxItem Content="Single view"/>
            </ComboBox>

            <TextBlock Text="Frequency scale" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="FreqCombo" Margin="0,0,0,8" SelectionChanged="FreqCombo_Changed">
              <ComboBoxItem Content="Linear"/>
              <ComboBoxItem Content="Log"/>
              <ComboBoxItem Content="Mel"/>
            </ComboBox>

            <TextBlock Text="Amplitude" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="AmpCombo" Margin="0,0,0,8" SelectionChanged="AmpCombo_Changed">
              <ComboBoxItem Content="Decibel (dB)"/>
              <ComboBoxItem Content="Linear"/>
            </ComboBox>

            <TextBlock Text="Colormap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="ColorCombo" Margin="0,0,0,8" SelectionChanged="ColorCombo_Changed">
              <ComboBoxItem Content="Magma"/>
              <ComboBoxItem Content="Viridis"/>
              <ComboBoxItem Content="Grayscale"/>
            </ComboBox>

            <TextBlock Text="FFT size" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="FftCombo" Margin="0,0,0,8" SelectionChanged="FftCombo_Changed">
              <ComboBoxItem Content="512"/>
              <ComboBoxItem Content="1024"/>
              <ComboBoxItem Content="2048"/>
              <ComboBoxItem Content="4096"/>
            </ComboBox>

            <TextBlock Text="Max frequency" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <ComboBox x:Name="MaxFreqCombo" Margin="0,0,0,8" SelectionChanged="MaxFreqCombo_Changed">
              <ComboBoxItem Content="Full"/>
              <ComboBoxItem Content="20 kHz"/>
              <ComboBoxItem Content="10 kHz"/>
              <ComboBoxItem Content="5 kHz"/>
            </ComboBox>

            <TextBlock Text="Contrast (dB floor)" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
            <Slider x:Name="ContrastSlider" Minimum="-120" Maximum="-40"
                    SmallChange="1" LargeChange="10" ValueChanged="ContrastSlider_Changed"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- Playback timeline on its own row, aligned to the plot area via the shared
         gutters so the seek position lines up with the waveform and spectrogram. -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="LeftGutter"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto" SharedSizeGroup="RightGutter"/>
      </Grid.ColumnDefinitions>
      <Slider x:Name="SeekSlider" Grid.Column="1" VerticalAlignment="Center"
              Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
              IsMoveToPointEnabled="True"
              Thumb.DragStarted="SeekSlider_DragStarted"
              Thumb.DragCompleted="SeekSlider_DragCompleted"
              ValueChanged="SeekSlider_ValueChanged"/>
    </Grid>

    <!-- View pane. A horizontally-scrollable timeline holds the waveform (top,
         1*) and spectrogram (bottom, 4*) at the same width, so they stay aligned
         in time; long files render in full and scroll instead of truncating.
         Single-view layout collapses the wave row to 0 and toggles one view.
         Timeline width is set in code; MinWidth keeps short files filling the pane. -->
    <Grid Grid.Row="2" x:Name="ViewPaneGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="LeftGutter"/>   <!-- frequency ruler -->
        <ColumnDefinition Width="*"/>                                    <!-- content (scroll + overlays) -->
        <ColumnDefinition Width="Auto" SharedSizeGroup="RightGutter"/>  <!-- colorbar legend -->
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>         <!-- views -->
        <RowDefinition Height="Auto"/>      <!-- time ruler -->
      </Grid.RowDefinitions>

      <!-- Frequency axis. Same height as the views row; TopFraction (set in code)
           aligns its ticks to the spectrogram band (0 single-view, 0.2 stacked). -->
      <ctl:FrequencyRuler x:Name="FreqRuler" Grid.Column="0" Grid.Row="0" Width="46"
                          Visibility="Collapsed"/>

      <!-- Content column: the scroll + overlays. Internals unchanged. -->
      <Grid x:Name="ContentGrid" Grid.Column="1" Grid.Row="0" ClipToBounds="True">
        <!-- Built-in scrollbar hidden; a dedicated one sits below the time axis (HScroll). -->
        <ScrollViewer x:Name="ViewScroll" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="ViewScroll_PreviewMouseWheel"
                      ScrollChanged="ViewScroll_ScrollChanged">
          <Grid x:Name="Timeline"
                Height="{Binding ViewportHeight, ElementName=ViewScroll}"
                MinWidth="{Binding ViewportWidth, ElementName=ViewScroll}">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="WaveRow" Height="1*"/>
              <RowDefinition x:Name="SpecRow" Height="4*"/>
            </Grid.RowDefinitions>

            <ctl:WaveformView x:Name="Waveform" Grid.Row="0"/>
            <Image x:Name="SpectrogramImage" Grid.Row="1" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseMove="SpectrogramImage_MouseMove" MouseLeave="SpectrogramImage_MouseLeave"/>
            <Rectangle x:Name="SpectrogramPlayhead" Grid.Row="0" Grid.RowSpan="2" Width="1.5"
                       Fill="{DynamicResource Playhead}" HorizontalAlignment="Left" Visibility="Collapsed"/>
          </Grid>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Loading…"/>

        <!-- Hover readout (time · frequency · level under the cursor). -->
        <Border x:Name="HoverReadout" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource OverlayBackground}" BorderBrush="{DynamicResource OverlayBorder}"
                BorderThickness="1" CornerRadius="3" Padding="6,3" Visibility="Collapsed"
                IsHitTestVisible="False">
          <Border.RenderTransform>
            <TranslateTransform x:Name="HoverTranslate"/>
          </Border.RenderTransform>
          <TextBlock x:Name="HoverText" Foreground="{DynamicResource OverlayText}"
                     FontFamily="Consolas, Courier New" FontSize="11"/>
        </Border>

        <!-- File-info overlay. Two presentation modes (see PluginSettings.FileInfoDisplay):
             HoverIcon (default) reveals this box while the InfoIcon pill is hovered and
             auto-hides it; DraggableBox anchors it bottom-right, draggable anywhere with a
             ✕ to dismiss and a remembered position. Wheel events are forwarded so the
             timeline still scrolls when the pointer is over it. -->
        <Border x:Name="FileInfoPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,10" Padding="9,6,9,7" CornerRadius="3" Background="{DynamicResource OverlayBackground}"
                BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" Visibility="Collapsed"
                Cursor="SizeAll"
                MouseLeftButtonDown="FileInfoPanel_MouseLeftButtonDown"
                MouseMove="FileInfoPanel_MouseMove"
                MouseLeftButtonUp="FileInfoPanel_MouseLeftButtonUp"
                MouseLeave="FileInfoPanel_MouseLeave"
                PreviewMouseWheel="ViewScroll_PreviewMouseWheel">
          <Border.RenderTransform>
            <TranslateTransform x:Name="FileInfoTranslate"/>
          </Border.RenderTransform>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="FileInfoClose" Grid.Row="0" Text="&#xE8BB;"
                       FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right"
                       Foreground="{DynamicResource OverlayClose}" Cursor="Hand" Margin="0,0,0,3" ToolTip="Close"
                       MouseLeftButtonDown="FileInfoClose_Click"/>
            <Image x:Name="AlbumArt" Grid.Row="1" MaxWidth="128" MaxHeight="128" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="FileInfoText" Grid.Row="2" Foreground="{DynamicResource OverlayText}"
                       FontFamily="Consolas, Courier New" FontSize="11"/>
          </Grid>
        </Border>

        <!-- Info affordance for HoverIcon mode: a small pill anchored bottom-right.
             Hovering it reveals FileInfoPanel just above; the box auto-hides on leave. -->
        <Border x:Name="InfoIcon" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,10" Padding="7,3" CornerRadius="10" Background="{DynamicResource OverlayBackground}"
                BorderBrush="{DynamicResource OverlayBorder}" BorderThickness="1" Visibility="Collapsed"
                Cursor="Hand" ToolTip="File info"
                MouseEnter="InfoIcon_MouseEnter" MouseLeave="InfoIcon_MouseLeave"
                PreviewMouseWheel="ViewScroll_PreviewMouseWheel">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource OverlayText}" VerticalAlignment="Center"/>
            <TextBlock Text="info" Foreground="{DynamicResource OverlayText}"
                       FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Colorbar legend. -->
      <ctl:SpectrogramColorbar x:Name="Colorbar" Grid.Column="2" Grid.Row="0" Width="52"
                               Margin="6,0,0,0" Visibility="Collapsed"/>

      <!-- Time axis below the content column; translated to follow the shared scroll. -->
      <Grid Grid.Column="1" Grid.Row="1" ClipToBounds="True" Height="18">
        <ctl:TimeRuler x:Name="TimeAxis" HorizontalAlignment="Left" Visibility="Collapsed"
                       Width="{Binding ActualWidth, ElementName=Timeline}">
          <ctl:TimeRuler.RenderTransform>
            <TranslateTransform x:Name="TimeRulerTranslate"/>
          </ctl:TimeRuler.RenderTransform>
        </ctl:TimeRuler>
      </Grid>
    </Grid>

    <!-- Horizontal scrollbar for long files, placed below the time axis (well clear
         of the spectrogram) and aligned to the plot via the shared gutters. -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="LeftGutter"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto" SharedSizeGroup="RightGutter"/>
      </Grid.ColumnDefinitions>
      <ScrollBar x:Name="HScroll" Grid.Column="1" Orientation="Horizontal" Minimum="0"
                 Margin="0,6,0,0" Visibility="Collapsed" Scroll="HScroll_Scroll"/>
    </Grid>

    <!-- Toggle button -->
    <Button x:Name="SpectrogramButton" Grid.Row="4" HorizontalAlignment="Right"
            Margin="0,8,0,0" Padding="10,4" Content="Spectrogram ▸"
            Click="SpectrogramButton_Click"/>
  </Grid>
</UserControl>
